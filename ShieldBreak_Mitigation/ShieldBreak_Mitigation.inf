; ShieldBreak_Mitigation.inf
; ShieldBreak Exploit Mitigation Minifilter

[Version]
Signature   = "$WINDOWS NT$"
Class       = "SecurityEnhancer"
ClassGuid   = {d02bc3da-0c8e-4945-9bd5-f1883c226c8c}
Provider    = %ProviderString%
DriverVer = 1/01/2026,1.0.0.0
CatalogFile = ShieldBreak_Mitigation.cat
PnpLockdown = 1

[SourceDisksNames]
1 = %Disk1%

[SourceDisksFiles]
ShieldBreak_Mitigation.sys = 1

[DestinationDirs]
ShieldBreak_MitigationDownlevel.CopyDriverFiles = 12            ;%windir%\system32\drivers
ShieldBreak_MitigationDownlevel.DelDriverFiles  = 12            ;%windir%\system32\drivers
ShieldBreak_Mitigation.DriverFiles              = 13            ;driver store

;;
;; Default install sections
;;

[DefaultInstall.NTamd64.10.0...25952]
OptionDesc          = %ShieldBreak_MitigationServiceDesc%
CopyFiles           = ShieldBreak_Mitigation.DriverFiles

[DefaultInstall.NTamd64.10.0...25952.Services]
AddService          = %ShieldBreak_MitigationServiceName%,,ShieldBreak_Mitigation.Service

;
; Support sections
;

[ShieldBreak_Mitigation.Service]
DisplayName      = %ShieldBreak_MitigationServiceName%
Description      = %ShieldBreak_MitigationServiceDesc%
ServiceBinary    = %13%\ShieldBreak_Mitigation.sys              ;driver store
Dependencies     = %FltmgrServiceName%                          ;FltMgr
ServiceType      = 2                                            ;SERVICE_FILE_SYSTEM_DRIVER
StartType        = 1                                            ;SERVICE_SYSTEM_START
ErrorControl     = 1                                            ;SERVICE_ERROR_NORMAL
LoadOrderGroup   = "FSFilter Security Enhancer"
AddReg           = ShieldBreak_Mitigation.AddRegistry, Common.AddRegistry

[ShieldBreak_Mitigation.AddRegistry]
HKR,"Parameters","SupportedFeatures",0x00010001,0x3
HKR,"Parameters\Instances",%RegDefaultInstanceValueName%,0x00000000,%DefaultInstance%
HKR,"Parameters\Instances\%Instance1.Name%",%RegAltitudeValueName%,0x00000000,%Instance1.Altitude%
HKR,"Parameters\Instances\%Instance1.Name%",%RegFlagsValueName%,0x00010001,%Instance1.Flags%

[ShieldBreak_Mitigation.DriverFiles]
ShieldBreak_Mitigation.sys

;;
;; Registry values shared for all OS versions
;;

[Common.AddRegistry]
HKR,"Parameters","DebugFlags",0x00010001,0

;;
;; Downlevel default install sections
;;

[DefaultInstall.NTamd64]
OptionDesc          = %ShieldBreak_MitigationServiceDesc%
CopyFiles           = ShieldBreak_MitigationDownlevel.CopyDriverFiles

[DefaultInstall.NTamd64.Services]
AddService          = %ShieldBreak_MitigationServiceName%,,ShieldBreak_MitigationDownlevel.Service

;;
;; Downlevel default uninstall sections
;;

[DefaultUninstall.NTamd64]
LegacyUninstall = 1
DelFiles        = ShieldBreak_MitigationDownlevel.DelDriverFiles

[DefaultUninstall.NTamd64.Services]
DelService      = %ShieldBreak_MitigationServiceName%,0x204

;
; Downlevel support sections
;

[ShieldBreak_MitigationDownlevel.Service]
DisplayName      = %ShieldBreak_MitigationServiceName%
Description      = %ShieldBreak_MitigationServiceDesc%
ServiceBinary    = %12%\ShieldBreak_Mitigation.sys              ;%windir%\system32\drivers
Dependencies     = %FltmgrServiceName%                          ;FltMgr
ServiceType      = 2                                            ;SERVICE_FILE_SYSTEM_DRIVER
StartType        = 1                                            ;SERVICE_SYSTEM_START
ErrorControl     = 1                                            ;SERVICE_ERROR_NORMAL
LoadOrderGroup   = "FSFilter Security Enhancer"
AddReg           = ShieldBreak_MitigationDownlevel.AddRegistry, Common.AddRegistry

[ShieldBreak_MitigationDownlevel.AddRegistry]
HKR,,"SupportedFeatures",0x00010001,0x3
HKR,"Instances",%RegDefaultInstanceValueName%,0x00000000,%DefaultInstance%
HKR,"Instances\%Instance1.Name%",%RegAltitudeValueName%,0x00000000,%Instance1.Altitude%
HKR,"Instances\%Instance1.Name%",%RegFlagsValueName%,0x00010001,%Instance1.Flags%

[ShieldBreak_MitigationDownlevel.CopyDriverFiles]
ShieldBreak_Mitigation.sys

[ShieldBreak_MitigationDownlevel.DelDriverFiles]
ShieldBreak_Mitigation.sys

;;
;; String Section
;;

[Strings]
ProviderString                      = "Sifps"
ShieldBreak_MitigationServiceDesc   = "ShieldBreak Exploit Mitigation Filter"
ShieldBreak_MitigationServiceName   = "ShieldBreak_Mitigation"
FltmgrServiceName                   = "FltMgr"
RegDefaultInstanceValueName         = "DefaultInstance"
RegAltitudeValueName                = "Altitude"
RegFlagsValueName                   = "Flags"
Disk1                               = "ShieldBreak_Mitigation Installation Disk"

;Instances specific information.
DefaultInstance      = "ShieldBreak_Mitigation Instance"
Instance1.Name       = "ShieldBreak_Mitigation Instance"
Instance1.Altitude   = "402050"
Instance1.Flags      = 0x0